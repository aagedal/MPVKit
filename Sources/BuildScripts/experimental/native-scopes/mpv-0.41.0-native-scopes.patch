 #include "command.h"
 #include "input/cmd.h"
@@ -621,3 +624,201 @@ void handle_each_frame_screenshot(struct MPContext *mpctx)
 
     mp_waiter_wait(&wait);
 }
+
+static bool aagedal_color_encoding(struct mp_image *src, const char **primaries,
+                                  const char **transfer);
+
+static struct mp_image *aagedal_source_raster(struct MPContext *mpctx)
+{
+    struct track *track = mpctx->current_track[0][STREAM_VIDEO];
+    if (mpctx->stop_play != KEEP_PLAYING ||
+        !mpctx->restart_complete || mpctx->seek.type || mpctx->hrseek_active ||
+        !mpctx->paused || !track || !track->dec ||
+        mpctx->opts->filter_opts->deinterlace != 0 ||
+        mpctx->opts->vo->video_crop.xy_valid ||
+        mpctx->opts->vo->video_crop.wh_valid ||
+        !isfinite(mpctx->video_pts) || mpctx->video_pts < 0 ||
+        (mpctx->opts->vf_settings && mpctx->opts->vf_settings[0].name))
+        return NULL;
+    struct mp_image *src = mp_decoder_wrapper_source_raster(track->dec,
+                                                           mpctx->video_pts);
+    if (!src)
+        return NULL;
+    struct mp_image_params sp = src->params;
+    const char *primaries = NULL, *transfer = NULL;
+    if (sp.aagedal_transform_invalid || sp.rotate < 0 || sp.rotate >= 360 ||
+        sp.rotate % 90 || sp.p_w != sp.p_h ||
+        sp.crop.x0 || sp.crop.y0 || sp.crop.x1 != src->w || sp.crop.y1 != src->h ||
+        sp.repr.bits.color_depth < 8 || sp.repr.bits.color_depth > 16 ||
+        !aagedal_color_encoding(src, &primaries, &transfer))
+        talloc_free(src);
+    else
+        return src;
+    return NULL;
+}
+
+double aagedal_decoder_raster_pts(struct MPContext *mpctx)
+{
+    struct mp_image *src = aagedal_source_raster(mpctx);
+    if (!src)
+        return NAN;
+    double pts = src->pts;
+    talloc_free(src);
+    return pts;
+}
+
+// Protocol 2 keeps source transfer/primaries and high-depth code values.
+// Orientation is a pixel permutation after same-size RGB conversion.
+static bool aagedal_color_encoding(struct mp_image *src, const char **primaries,
+                                  const char **transfer)
+{
+    struct mp_image_params p = src->params;
+    if (src->icc_profile || src->dovi || p.repr.sys == PL_COLOR_SYSTEM_DOLBYVISION ||
+        p.repr.alpha == PL_ALPHA_PREMULTIPLIED ||
+        (p.repr.sys != PL_COLOR_SYSTEM_RGB && p.repr.sys != PL_COLOR_SYSTEM_BT_709 &&
+         p.repr.sys != PL_COLOR_SYSTEM_BT_601 && p.repr.sys != PL_COLOR_SYSTEM_BT_2020_NC))
+        return false;
+    if (p.color.primaries == PL_COLOR_PRIM_BT_709) {
+        *primaries = "bt709";
+        switch (p.color.transfer) {
+        case PL_COLOR_TRC_SRGB: *transfer = "srgb"; return true;
+        case PL_COLOR_TRC_BT_1886: *transfer = "bt1886"; return true;
+        case PL_COLOR_TRC_GAMMA22: *transfer = "gamma22"; return true;
+        case PL_COLOR_TRC_GAMMA24: *transfer = "gamma24"; return true;
+        default: return false;
+        }
+    }
+    if (p.color.primaries == PL_COLOR_PRIM_BT_2020) {
+        *primaries = "bt2020";
+        switch (p.color.transfer) {
+        case PL_COLOR_TRC_PQ: *transfer = "pq"; return true;
+        case PL_COLOR_TRC_HLG: *transfer = "hlg"; return true;
+        default: return false;
+        }
+    }
+    return false;
+}
+
+void cmd_aagedal_decoder_raster(void *p)
+{
+    struct mp_cmd_ctx *cmd = p;
+    struct MPContext *mpctx = cmd->mpctx;
+    struct track *track = mpctx->current_track[0][STREAM_VIDEO];
+    cmd->success = false;
+    struct mp_image *src = aagedal_source_raster(mpctx);
+    if (!src)
+        return;
+    const char *primaries = NULL, *transfer = NULL;
+    if (!aagedal_color_encoding(src, &primaries, &transfer))
+        goto done;
+    int source_depth = src->params.repr.bits.color_depth;
+    if (source_depth < 8 || source_depth > 16)
+        goto done;
+    bool hardware = IMGFMT_IS_HWACCEL(src->imgfmt);
+    if (hardware) {
+        int w = src->w, h = src->h;
+        struct mp_image *download = mp_image_hw_download(src, NULL);
+        if (!download)
+            goto done;
+        talloc_free(src);
+        src = download;
+        if (src->w != w || src->h != h || IMGFMT_IS_HWACCEL(src->imgfmt) ||
+            mp_image_approx_byte_size(src) <= 0 ||
+            mp_image_approx_byte_size(src) > 72 * 1024 * 1024)
+            goto done;
+    }
+    bool high_depth = source_depth > 8 || !strcmp(transfer, "pq") || !strcmp(transfer, "hlg");
+    // Normalize interleaved 8-bit chroma without resampling. The x86 NV12
+    // unscaled RGB shortcut differs from the planar conversion in swscale;
+    // use the same color path for software and downloaded VideoToolbox frames.
+    if (src->imgfmt == IMGFMT_NV12) {
+        struct mp_image *planar = mp_image_alloc(IMGFMT_420P, src->w, src->h);
+        if (!planar)
+            goto done;
+        mp_image_copy_attributes(planar, src);
+        for (int y = 0; y < src->h; y++)
+            memcpy(planar->planes[0] + y * planar->stride[0],
+                   src->planes[0] + y * src->stride[0], src->w);
+        for (int y = 0; y < (src->h + 1) / 2; y++) {
+            for (int x = 0; x < (src->w + 1) / 2; x++) {
+                planar->planes[1][y * planar->stride[1] + x] = src->planes[1][y * src->stride[1] + 2 * x];
+                planar->planes[2][y * planar->stride[2] + x] = src->planes[1][y * src->stride[1] + 2 * x + 1];
+            }
+        }
+        talloc_free(src);
+        src = planar;
+    }
+    int format = high_depth ? IMGFMT_RGBA64 : IMGFMT_BGRA;
+    int bytes_per_pixel = high_depth ? 8 : 4;
+    int rotation = src->params.rotate;
+    bool mirrored = src->params.vflip;
+    struct mp_image *rgb = mp_image_alloc(format, src->w, src->h);
+    if (!rgb)
+        goto done;
+    mp_image_copy_attributes(rgb, src);
+    rgb->params.p_w = rgb->params.p_h = 1;
+    rgb->params.rotate = 0;
+    rgb->params.vflip = false;
+    struct mp_sws_context *sws = mp_sws_alloc(NULL);
+    bool ok = mp_sws_scale(sws, rgb, src) >= 0;
+    talloc_free(sws);
+    if (!ok) {
+        talloc_free(rgb);
+        goto done;
+    }
+    if (rotation || mirrored) {
+        bool swapped = rotation == 90 || rotation == 270;
+        struct mp_image *oriented = mp_image_alloc(format, swapped ? src->h : src->w,
+                                                   swapped ? src->w : src->h);
+        if (!oriented) {
+            talloc_free(rgb);
+            goto done;
+        }
+        mp_image_copy_attributes(oriented, rgb);
+        oriented->params.crop = (struct mp_rect){0, 0, oriented->w, oriented->h};
+        for (int y = 0; y < src->h; y++) {
+            for (int x = 0; x < src->w; x++) {
+                int fy = mirrored ? src->h - 1 - y : y;
+                int dx = x, dy = fy;
+                if (rotation == 90) { dx = src->h - 1 - fy; dy = x; }
+                if (rotation == 180) { dx = src->w - 1 - x; dy = src->h - 1 - fy; }
+                if (rotation == 270) { dx = fy; dy = src->w - 1 - x; }
+                memcpy(oriented->planes[0] + dy * oriented->stride[0] + dx * bytes_per_pixel,
+                       rgb->planes[0] + y * rgb->stride[0] + x * bytes_per_pixel, bytes_per_pixel);
+            }
+        }
+        talloc_free(rgb);
+        rgb = oriented;
+    }
+    if (rgb->stride[0] <= 0 || (int64_t)rgb->stride[0] * rgb->h > 72 * 1024 * 1024) {
+        talloc_free(rgb);
+        goto done;
+    }
+    struct mpv_node *res = &cmd->result;
+    node_init(res, MPV_FORMAT_NODE_MAP, NULL);
+    node_map_add_int64(res, "protocol", 2);
+    node_map_add_int64(res, "w", rgb->w);
+    node_map_add_int64(res, "h", rgb->h);
+    node_map_add_int64(res, "coded-w", src->w);
+    node_map_add_int64(res, "coded-h", src->h);
+    node_map_add_int64(res, "stride", rgb->stride[0]);
+    node_map_add_int64(res, "rotation", rotation);
+    node_map_add_int64(res, "track-id", track->user_tid);
+    node_map_add_int64(res, "source-bit-depth", source_depth);
+    node_map_add_double(res, "pts", src->pts);
+    node_map_add_flag(res, "mirrored", mirrored);
+    node_map_add_flag(res, "hardware-transfer", hardware);
+    node_map_add_flag(res, "pixel-preserving", true);
+    node_map_add_flag(res, "presented-frame", true);
+    node_map_add_string(res, "primaries", primaries);
+    node_map_add_string(res, "transfer", transfer);
+    node_map_add_string(res, "format", high_depth ? "rgba64" : "bgra");
+    struct mpv_byte_array *ba = node_map_add(res, "data", MPV_FORMAT_BYTE_ARRAY)->u.ba;
+    *ba = (struct mpv_byte_array){rgb->planes[0], rgb->stride[0] * rgb->h};
+    talloc_steal(ba, rgb);
+    cmd->success = true;
+done:
+    talloc_free(src);
+}
