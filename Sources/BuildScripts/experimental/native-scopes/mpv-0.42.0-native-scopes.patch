+// Called by the core while paused. The decoder may still run ahead, so only
+// an unambiguous exact match of the presented PTS is returned, never the
+// newest frame.
+struct mp_image *mp_decoder_wrapper_source_raster(struct mp_decoder_wrapper *d,
+                                                  double pts)
+{
+    struct priv *p = d->f->priv;
+    thread_lock(p);
+    bool allowed = raster_allowed(p, p->fixed_format.w, p->fixed_format.h);
+    thread_unlock(p);
+    if (!allowed)
+        return NULL;
+
+    struct mp_image *result = NULL;
+    int matches = 0;
+    mp_mutex_lock(&p->cache_lock);
+    for (int n = 0; !p->raster_pts_ambiguous && n < MP_ARRAY_SIZE(p->rasters); n++) {
+        if (p->rasters[n] && p->rasters[n]->pts == pts && !matches++)
+            result = mp_image_new_ref(p->rasters[n]);
+    }
+    mp_mutex_unlock(&p->cache_lock);
+    if (matches != 1)
+        mp_image_unrefp(&result);
+    return result;
+}
