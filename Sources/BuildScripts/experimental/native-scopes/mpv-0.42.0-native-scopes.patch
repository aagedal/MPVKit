diff --git a/player/decoder_raster.c b/player/decoder_raster.c
new file mode 100644
index 0000000..85f2db8
--- /dev/null
+++ b/player/decoder_raster.c
@@ -0,0 +1,293 @@
+// Copyright © 2026 Truls Aagedal
+// SPDX-License-Identifier: GPL-3.0-or-later
+//
+// aagedal-decoder-raster (protocol 2): while paused, the decoder's own raster
+// of the presented frame converted to RGB on its native grid. Requires
+// --aagedal-decoder-raster, which keeps a few decoder output references.
+
+#include <math.h>
+#include <string.h>
+
+
+#include "mpv_talloc.h"
+#include "command.h"
+#include "core.h"
+#include "filters/f_decoder_wrapper.h"
+#include "input/cmd.h"
+#include "misc/node.h"
+#include "options/m_option.h"
+#include "options/options.h"
+#include "screenshot.h"
+#include "video/mp_image.h"
+#include "video/mp_image_pool.h"
+#include "video/sws_utils.h"
+
+#define MAX_RASTER_BYTES (72 * 1024 * 1024)
+
+// Source transfer/primaries the consumer can interpret, as protocol names.
+static bool color_encoding(struct mp_image *src, const char **primaries,
+                           const char **transfer)
+{
+    struct mp_image_params p = src->params;
+    if (src->icc_profile || src->dovi || p.repr.alpha == PL_ALPHA_PREMULTIPLIED)
+        return false;
+    switch (p.repr.sys) {
+    case PL_COLOR_SYSTEM_RGB:
+    case PL_COLOR_SYSTEM_BT_709:
+    case PL_COLOR_SYSTEM_BT_601:
+    case PL_COLOR_SYSTEM_BT_2020_NC:
+        break;
+    default:
+        return false;
+    }
+
+    *transfer = NULL;
+    if (p.color.primaries == PL_COLOR_PRIM_BT_709) {
+        *primaries = "bt709";
+        switch (p.color.transfer) {
+        case PL_COLOR_TRC_SRGB:     *transfer = "srgb"; break;
+        case PL_COLOR_TRC_BT_1886:  *transfer = "bt1886"; break;
+        case PL_COLOR_TRC_GAMMA22:  *transfer = "gamma22"; break;
+        case PL_COLOR_TRC_GAMMA24:  *transfer = "gamma24"; break;
+        default: break;
+        }
+    } else if (p.color.primaries == PL_COLOR_PRIM_BT_2020) {
+        *primaries = "bt2020";
+        switch (p.color.transfer) {
+        case PL_COLOR_TRC_PQ:  *transfer = "pq"; break;
+        case PL_COLOR_TRC_HLG: *transfer = "hlg"; break;
+        default: break;
+        }
+    }
+    return *transfer;
+}
+
+// The cached decoder raster for the presented PTS, if playback state allows
+// an exact, unambiguous association.
+static struct mp_image *source_raster(struct MPContext *mpctx)
+{
+    struct track *track = mpctx->current_track[0][STREAM_VIDEO];
+    struct MPOpts *opts = mpctx->opts;
+    if (mpctx->stop_play != KEEP_PLAYING || !mpctx->restart_complete ||
+        mpctx->seek.type || mpctx->hrseek_active || !mpctx->paused ||
+        !track || !track->dec || opts->filter_opts->deinterlace != 0 ||
+        opts->vo->video_crop.xy_valid || opts->vo->video_crop.wh_valid ||
+        !isfinite(mpctx->video_pts) || mpctx->video_pts < 0 ||
+        (opts->vf_settings && opts->vf_settings[0].name))
+        return NULL;
+
+    struct mp_image *src = mp_decoder_wrapper_source_raster(track->dec, mpctx->video_pts);
+    if (!src)
+        return NULL;
+    struct mp_image_params sp = src->params;
+    const char *primaries, *transfer;
+    if (sp.aagedal_transform_invalid || sp.rotate < 0 || sp.rotate >= 360 ||
+        sp.rotate % 90 || sp.p_w != sp.p_h ||
+        sp.crop.x0 || sp.crop.y0 || sp.crop.x1 != src->w || sp.crop.y1 != src->h ||
+        sp.repr.bits.color_depth < 8 || sp.repr.bits.color_depth > 16 ||
+        !color_encoding(src, &primaries, &transfer))
+    {
+        talloc_free(src);
+        return NULL;
+    }
+    return src;
+}
+
+double aagedal_decoder_raster_pts(struct MPContext *mpctx)
+{
+    struct mp_image *src = source_raster(mpctx);
+    double pts = src ? src->pts : NAN;
+    talloc_free(src);
+    return pts;
+}
+
+// swscale's unscaled NV12 path rounds differently from planar 4:2:0, so split
+// the interleaved chroma (without resampling) to give hardware and software
+// decodes of the same stream the same RGB.
+static struct mp_image *nv12_to_420p(struct mp_image *src)
+{
+    struct mp_image *dst = mp_image_alloc(IMGFMT_420P, src->w, src->h);
+    if (!dst)
+        return NULL;
+    mp_image_copy_attributes(dst, src);
+    memcpy_pic(dst->planes[0], src->planes[0], src->w, src->h,
+               dst->stride[0], src->stride[0]);
+    int cw = (src->w + 1) / 2, ch = (src->h + 1) / 2;
+    for (int y = 0; y < ch; y++) {
+        const uint8_t *uv = src->planes[1] + y * src->stride[1];
+        uint8_t *u = dst->planes[1] + y * dst->stride[1];
+        uint8_t *v = dst->planes[2] + y * dst->stride[2];
+        for (int x = 0; x < cw; x++) {
+            u[x] = uv[2 * x];
+            v[x] = uv[2 * x + 1];
+        }
+    }
+    return dst;
+}
+
+// Destination of source pixel (x, y) of a w x h image that is mirrored
+// vertically, then rotated clockwise.
+static inline void orient_pos(int rotation, bool mirrored, int w, int h,
+                              int x, int y, int *dx, int *dy)
+{
+    int fy = mirrored ? h - 1 - y : y;
+    switch (rotation) {
+    case 90:  *dx = h - 1 - fy; *dy = x; break;
+    case 180: *dx = w - 1 - x;  *dy = h - 1 - fy; break;
+    case 270: *dx = fy;         *dy = w - 1 - x; break;
+    default:  *dx = x;          *dy = fy; break;
+    }
+}
+
+#define ORIENT_TILE 32
+
+#define DEF_ORIENT(name, type)                                                 \
+static void name(struct mp_image *dst, struct mp_image *src, int rotation,      \
+                 bool mirrored)                                                 \
+{                                                                               \
+    int w = src->w, h = src->h;                                                 \
+    if (rotation == 180) {                                                      \
+        /* Whole rows, reversed. */                                             \
+        for (int y = 0; y < h; y++) {                                           \
+            const type *row = (const type *)(src->planes[0] + y * src->stride[0]);\
+            int dy = mirrored ? y : h - 1 - y;                                  \
+            type *out = (type *)(dst->planes[0] + dy * dst->stride[0]);         \
+            for (int x = 0; x < w; x++)                                         \
+                out[w - 1 - x] = row[x];                                        \
+        }                                                                       \
+        return;                                                                 \
+    }                                                                           \
+    for (int ty = 0; ty < h; ty += ORIENT_TILE) {                               \
+        for (int tx = 0; tx < w; tx += ORIENT_TILE) {                           \
+            int ex = MPMIN(tx + ORIENT_TILE, w), ey = MPMIN(ty + ORIENT_TILE, h);\
+            for (int y = ty; y < ey; y++) {                                     \
+                const type *row = (const type *)(src->planes[0] + y * src->stride[0]);\
+                for (int x = tx; x < ex; x++) {                                 \
+                    int dx, dy;                                                 \
+                    orient_pos(rotation, mirrored, w, h, x, y, &dx, &dy);       \
+                    ((type *)(dst->planes[0] + dy * dst->stride[0]))[dx] = row[x];\
+                }                                                               \
+            }                                                                   \
+        }                                                                       \
+    }                                                                           \
+}
+
+DEF_ORIENT(orient_32, uint32_t)
+DEF_ORIENT(orient_64, uint64_t)
+
+static struct mp_image *orient(struct mp_image *rgb, int rotation, bool mirrored,
+                               bool high_depth)
+{
+    bool swapped = rotation == 90 || rotation == 270;
+    struct mp_image *dst = mp_image_alloc(rgb->imgfmt, swapped ? rgb->h : rgb->w,
+                                          swapped ? rgb->w : rgb->h);
+    if (!dst)
+        return NULL;
+    mp_image_copy_attributes(dst, rgb);
+    dst->params.crop = (struct mp_rect){0, 0, dst->w, dst->h};
+    if (!rotation) {
+        // Pure mirror: whole rows.
+        for (int y = 0; y < rgb->h; y++) {
+            memcpy(dst->planes[0] + (rgb->h - 1 - y) * dst->stride[0],
+                   rgb->planes[0] + y * rgb->stride[0], rgb->w * (high_depth ? 8 : 4));
+        }
+    } else if (high_depth) {
+        orient_64(dst, rgb, rotation, mirrored);
+    } else {
+        orient_32(dst, rgb, rotation, mirrored);
+    }
+    return dst;
+}
+
+void cmd_aagedal_decoder_raster(void *p)
+{
+    struct mp_cmd_ctx *cmd = p;
+    struct MPContext *mpctx = cmd->mpctx;
+    struct track *track = mpctx->current_track[0][STREAM_VIDEO];
+    struct mp_image *rgb = NULL;
+    cmd->success = false;
+
+    struct mp_image *src = source_raster(mpctx);
+    if (!src)
+        return;
+    const char *primaries, *transfer;
+    if (!color_encoding(src, &primaries, &transfer))
+        goto done;
+    int source_depth = src->params.repr.bits.color_depth;
+
+    bool hardware = IMGFMT_IS_HWACCEL(src->imgfmt);
+    if (hardware) {
+        int w = src->w, h = src->h;
+        struct mp_image *sw = mp_image_hw_map_or_download(src);
+        if (!sw)
+            goto done;
+        talloc_free(src);
+        src = sw;
+        if (src->w != w || src->h != h || IMGFMT_IS_HWACCEL(src->imgfmt) ||
+            mp_image_approx_byte_size(src) <= 0 ||
+            mp_image_approx_byte_size(src) > MAX_RASTER_BYTES)
+            goto done;
+    }
+    if (src->imgfmt == IMGFMT_NV12) {
+        struct mp_image *planar = nv12_to_420p(src);
+        if (!planar)
+            goto done;
+        talloc_free(src);
+        src = planar;
+    }
+
+    bool high_depth = source_depth > 8 || !strcmp(transfer, "pq") ||
+                      !strcmp(transfer, "hlg");
+    int rotation = src->params.rotate;
+    bool mirrored = src->params.vflip;
+    rgb = mp_image_alloc(high_depth ? IMGFMT_RGBA64 : IMGFMT_BGRA, src->w, src->h);
+    if (!rgb)
+        goto done;
+    mp_image_copy_attributes(rgb, src);
+    rgb->params.p_w = rgb->params.p_h = 1;
+    rgb->params.rotate = 0;
+    rgb->params.vflip = false;
+    struct mp_sws_context *sws = mp_sws_alloc(NULL);
+    bool ok = mp_sws_scale(sws, rgb, src) >= 0;
+    talloc_free(sws);
+    if (!ok)
+        goto done;
+
+    if (rotation || mirrored) {
+        struct mp_image *oriented = orient(rgb, rotation, mirrored, high_depth);
+        if (!oriented)
+            goto done;
+        talloc_free(rgb);
+        rgb = oriented;
+    }
+    if (rgb->stride[0] <= 0 || (int64_t)rgb->stride[0] * rgb->h > MAX_RASTER_BYTES)
+        goto done;
+
+    struct mpv_node *res = &cmd->result;
+    node_init(res, MPV_FORMAT_NODE_MAP, NULL);
+    node_map_add_int64(res, "protocol", 2);
+    node_map_add_int64(res, "w", rgb->w);
+    node_map_add_int64(res, "h", rgb->h);
+    node_map_add_int64(res, "coded-w", src->w);
+    node_map_add_int64(res, "coded-h", src->h);
+    node_map_add_int64(res, "stride", rgb->stride[0]);
+    node_map_add_int64(res, "rotation", rotation);
+    node_map_add_int64(res, "track-id", track->user_tid);
+    node_map_add_int64(res, "source-bit-depth", source_depth);
+    node_map_add_double(res, "pts", src->pts);
+    node_map_add_flag(res, "mirrored", mirrored);
+    node_map_add_flag(res, "hardware-transfer", hardware);
+    node_map_add_flag(res, "pixel-preserving", true);
+    node_map_add_flag(res, "presented-frame", true);
+    node_map_add_string(res, "primaries", primaries);
+    node_map_add_string(res, "transfer", transfer);
+    node_map_add_string(res, "format", high_depth ? "rgba64" : "bgra");
+    struct mpv_byte_array *ba = node_map_add(res, "data", MPV_FORMAT_BYTE_ARRAY)->u.ba;
+    *ba = (struct mpv_byte_array){rgb->planes[0], rgb->stride[0] * rgb->h};
+    talloc_steal(ba, rgb);
+    rgb = NULL;
+    cmd->success = true;
+done:
+    talloc_free(rgb);
+    talloc_free(src);
+}
diff --git a/player/scopes.c b/player/scopes.c
new file mode 100644
index 0000000..d7f1601
--- /dev/null
+++ b/player/scopes.c
@@ -0,0 +1,175 @@
+// Copyright © 2026 Truls Aagedal
+// SPDX-License-Identifier: GPL-3.0-or-later
+//
+// aagedal-scopes: waveform, RGBY parade and vectorscope of the presented frame.
+// The VO computes them on the GPU when it can (vo_gpu_next); otherwise the
+// current VO frame is analysed on the CPU with the core unlocked.
+
+#include <libswscale/swscale.h>
+
+#include "mpv_talloc.h"
+#include "command.h"
+#include "core.h"
+#include "input/cmd.h"
+#include "misc/node.h"
+#include "options/m_option.h"
+#include "screenshot.h"
+#include "video/csputils.h"
+#include "video/mp_image.h"
+#include "video/mp_image_pool.h"
+#include "video/out/vo.h"
+#include "video/scope.h"
+#include "video/sws_utils.h"
+
+enum { BACKEND_AUTO, BACKEND_GPU, BACKEND_CPU };
+
+static bool playback_settled(struct MPContext *mpctx, struct track *track)
+{
+    return track && track->dec && mpctx->current_track[0][STREAM_VIDEO] == track &&
+           mpctx->stop_play == KEEP_PLAYING && mpctx->restart_complete &&
+           !mpctx->seek.type && !mpctx->hrseek_active &&
+           mpctx->video_out && mpctx->video_out->config_ok;
+}
+
+static struct mp_scope_result *scopes_cpu(struct mp_image *src, int w, int plots,
+                                          int analysis)
+{
+    struct mp_scope_result *res = NULL;
+    struct mp_image *rgb = NULL;
+    struct mp_sws_context *sws = NULL;
+    uint32_t *bins = NULL;
+
+    if (IMGFMT_IS_HWACCEL(src->imgfmt)) {
+        struct mp_image *sw = mp_image_hw_map_or_download(src);
+        talloc_free(src);
+        src = sw;
+        if (!src)
+            goto done;
+    }
+    mp_image_params_guess_csp(&src->params);
+    struct mp_image_params *par = &src->params;
+    struct mp_scope_params sp;
+    if (src->icc_profile || src->dovi || par->repr.sys == PL_COLOR_SYSTEM_DOLBYVISION ||
+        par->rotate % 90 || !mp_scope_params_init(&sp, w, plots, &par->color))
+        goto done;
+
+    if (mp_image_crop_valid(par))
+        mp_image_crop_rc(src, par->crop);
+    // Analyse at the plot width by default; the CPU cost scales with samples.
+    int edge = analysis > 0 ? analysis : w;
+    int maxaxis = MPMAX(src->w, src->h);
+    double scale = MPMIN(1.0, edge / (double)maxaxis);
+    int aw = MPMAX(1, lrint(src->w * scale)), ah = MPMAX(1, lrint(src->h * scale));
+    if ((int64_t)aw * ah > MP_SCOPE_MAX_SAMPLES)
+        goto done;
+
+    rgb = mp_image_alloc(IMGFMT_RGBA64, aw, ah);
+    if (!rgb)
+        goto done;
+    mp_image_copy_attributes(rgb, src);
+    rgb->params.p_w = rgb->params.p_h = 1;
+    rgb->params.rotate = 0;
+    rgb->params.vflip = false;
+    // Area averaging of the encoded values, never tone mapped or clamped.
+    sws = mp_sws_alloc(NULL);
+    sws->flags = SWS_AREA;
+    if (mp_sws_scale(sws, rgb, src) < 0)
+        goto done;
+
+    struct mp_scope_layout l;
+    mp_scope_layout(&sp, &l);
+    bins = calloc(l.total, sizeof(*bins));
+    res = talloc_zero(NULL, struct mp_scope_result);
+    if (!bins || !res)
+        goto fail;
+    for (int i = 0; i < 3; i++) {
+        if (sp.plots & (1 << i))
+            res->plot[i] = talloc_zero_size(res, mp_scope_plot_size(&sp, i));
+    }
+    mp_scope_accumulate(&sp, bins, (const uint16_t *)rgb->planes[0], aw, ah,
+                        rgb->stride[0], par->rotate);
+    mp_scope_paint(&sp, bins, res->plot);
+
+    res->params = sp;
+    res->pts = src->pts;
+    res->primaries = m_opt_choice_str(pl_csp_prim_names, par->color.primaries);
+    res->transfer = m_opt_choice_str(pl_csp_trc_names, par->color.transfer);
+    bool swap = par->rotate == 90 || par->rotate == 270;
+    res->analysis_w = swap ? ah : aw;
+    res->analysis_h = swap ? aw : ah;
+    goto done;
+
+fail:
+    TA_FREEP(&res);
+done:
+    free(bins);
+    talloc_free(sws);
+    talloc_free(rgb);
+    talloc_free(src);
+    return res;
+}
+
+void cmd_aagedal_scopes(void *p)
+{
+    struct mp_cmd_ctx *cmd = p;
+    struct MPContext *mpctx = cmd->mpctx;
+    int w = cmd->args[0].v.i, plots = cmd->args[1].v.i;
+    int backend = cmd->args[2].v.i, analysis = cmd->args[3].v.i;
+    cmd->success = false;
+
+    struct track *track = mpctx->current_track[0][STREAM_VIDEO];
+    if (!plots || !playback_settled(mpctx, track))
+        return;
+    int track_id = track->user_tid;
+
+    struct mp_scope_result *res = NULL;
+    if (backend != BACKEND_CPU) {
+        struct voctrl_aagedal_scopes ctrl = {
+            .w = w,
+            .plots = plots,
+            .analysis = analysis,
+        };
+        if (vo_control(mpctx->video_out, VOCTRL_AAGEDAL_SCOPES, &ctrl) == VO_TRUE)
+            res = ctrl.res;
+    }
+    if (!res && backend != BACKEND_GPU) {
+        // The worker owns this frame reference while playback continues.
+        struct mp_image *src = vo_get_current_frame(mpctx->video_out);
+        if (src) {
+            mp_core_unlock(mpctx);
+            res = scopes_cpu(src, w, plots, analysis);
+            mp_core_lock(mpctx);
+        }
+    }
+    if (!res || !isfinite(res->pts) || !playback_settled(mpctx, track)) {
+        talloc_free(res);
+        return;
+    }
+
+    const struct mp_scope_params *sp = &res->params;
+    struct mpv_node *node = &cmd->result;
+    node_init(node, MPV_FORMAT_NODE_MAP, NULL);
+    node_map_add_int64(node, "protocol", 2);
+    node_map_add_int64(node, "w", sp->w);
+    node_map_add_int64(node, "h", sp->h);
+    node_map_add_int64(node, "track-id", track_id);
+    node_map_add_double(node, "pts", res->pts);
+    node_map_add_string(node, "primaries", res->primaries);
+    node_map_add_string(node, "transfer", res->transfer);
+    node_map_add_double(node, "peak-nits", sp->peak);
+    node_map_add_flag(node, "dolby-vision", res->dolby_vision);
+    node_map_add_string(node, "backend", res->gpu ? "gpu" : "cpu");
+    node_map_add_int64(node, "analysis-w", res->analysis_w);
+    node_map_add_int64(node, "analysis-h", res->analysis_h);
+    node_map_add_string(node, "format", "bgra-premultiplied");
+    static const char *const keys[] = {"waveform", "parade", "vectorscope"};
+    for (int i = 0; i < 3; i++) {
+        if (!res->plot[i])
+            continue;
+        struct mpv_byte_array *ba = node_map_add(node, keys[i], MPV_FORMAT_BYTE_ARRAY)->u.ba;
+        *ba = (struct mpv_byte_array){res->plot[i], mp_scope_plot_size(sp, i)};
+        talloc_steal(ba, res->plot[i]);
+    }
+    talloc_free(res);
+    cmd->success = true;
+}
