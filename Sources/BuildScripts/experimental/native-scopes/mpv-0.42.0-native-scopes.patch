+bool mp_av_display_matrix_is_pixel_preserving(const int32_t *m)
+{
+    const int unit = 1 << 16;
+    int a = m[0], b = m[1], c = m[3], d = m[4];
+    // Whole-pixel orthogonal rotations/reflections and integral translation.
+    // No scale, shear, perspective, or truncated fractional rotation.
+    bool diagonal = (a == unit || a == -unit) && b == 0 && c == 0 &&
+                    (d == unit || d == -unit);
+    bool swapped = a == 0 && (b == unit || b == -unit) &&
+                   (c == unit || c == -unit) && d == 0;
+    return (diagonal || swapped) && m[2] == 0 && m[5] == 0 &&
+           m[8] == (1 << 30) && m[6] % unit == 0 && m[7] % unit == 0;
+}
