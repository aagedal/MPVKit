+#define SCOPE_DEFAULT_ANALYSIS 1920
+
+// Scopes of the frame a screenshot would capture, analysed in its own
+// encoding at up to `analysis` pixels along the longest displayed edge.
+static bool video_scopes(struct vo *vo, struct voctrl_aagedal_scopes *args)
+{
+    struct priv *p = vo->priv;
+    args->res = NULL;
+
+    struct pl_frame_mix mix;
+    struct pl_queue_params qparams = *pl_queue_params(
+        .pts = p->last_pts,
+        .drift_compensation = 0,
+    );
+    enum pl_queue_status status = pl_queue_update(p->queue, &mix, &qparams);
+    if (status == PL_QUEUE_ERR || status == PL_QUEUE_EOF || !mix.num_frames)
+        return false;
+
+    struct pl_frame image = *mix.frames[0];
+    struct mp_image *mpi = image.user_data;
+    // ICC tagged code values have no meaning on a standard scope axis.
+    if (image.profile.len)
+        return false;
+
+    // Dolby Vision is analysed after reshaping, as the PQ signal it decodes to.
+    bool dovi = image.repr.sys == PL_COLOR_SYSTEM_DOLBYVISION;
+    struct mp_image_params par = mpi->params;
+    mp_image_params_guess_csp(&par);
+    struct pl_color_space report = par.color, encode = image.color;
+    if (dovi) {
+        report = encode = (struct pl_color_space) {
+            .primaries = PL_COLOR_PRIM_BT_2020,
+            .transfer = PL_COLOR_TRC_PQ,
+            .hdr = image.color.hdr,
+        };
+    }
+
+    struct mp_scope_params sp;
+    if (!mp_scope_params_init(&sp, args->w, args->plots, &report))
+        return false;
+
+    int w, h;
+    mp_image_params_get_dsize(&mpi->params, &w, &h);
+    int src_w = mpi->params.w, src_h = mpi->params.h;
+    if (w < 1 || h < 1)
+        return false;
+    struct mp_rect src = {0, 0, src_w, src_h};
+    if (mp_image_crop_valid(&mpi->params))
+        src = mpi->params.crop;
+    if (mpi->params.rotate % 180 == 90) {
+        MPSWAP(int, w, h);
+        MPSWAP(int, src_w, src_h);
+    }
+    mp_rect_rotate(&src, src_w, src_h, mpi->params.rotate);
+    apply_crop(&image, src, mpi->params.w, mpi->params.h);
+
+    int edge = args->analysis > 0 ? args->analysis : SCOPE_DEFAULT_ANALYSIS;
+    double scale = MPMIN(1.0, edge / (double)MPMAX(w, h));
+    int aw = MPMAX(1, lrint(w * scale)), ah = MPMAX(1, lrint(h * scale));
+
+    if (!p->scopes)
+        p->scopes = gpu_scopes_create(p, p->pllog, p->gpu);
+    if (!p->scopes)
+        return false;
+
+    struct mp_scope_result *res = talloc_zero(NULL, struct mp_scope_result);
+    for (int i = 0; i < 3; i++) {
+        if (sp.plots & (1 << i))
+            res->plot[i] = talloc_size(res, mp_scope_plot_size(&sp, i));
+    }
+    if (!gpu_scopes_run(p->scopes, p->rr, &image, &encode, &sp, aw, ah, res->plot)) {
+        talloc_free(res);
+        return false;
+    }
+
+    res->params = sp;
+    res->pts = mpi->pts;
+    res->primaries = m_opt_choice_str(pl_csp_prim_names, report.primaries);
+    res->transfer = m_opt_choice_str(pl_csp_trc_names, report.transfer);
+    res->analysis_w = aw;
+    res->analysis_h = ah;
+    res->dolby_vision = dovi;
+    res->gpu = true;
+    args->res = res;
+    return true;
+}
