diff --git a/video/out/gpu_next/scopes.c b/video/out/gpu_next/scopes.c
new file mode 100644
index 0000000..1ba7808
--- /dev/null
+++ b/video/out/gpu_next/scopes.c
@@ -0,0 +1,389 @@
+// Copyright © 2026 Truls Aagedal
+// SPDX-License-Identifier: GPL-3.0-or-later
+//
+// GPU scope analysis: the current frame is rendered once into a small RGBA16
+// raster in its own encoding, then compute passes bin every sample with
+// atomics and paint the plots. Only the painted plots are read back. The
+// binning and painting mirror video/scope.c.
+
+#include <libplacebo/dispatch.h>
+#include <libplacebo/shaders/custom.h>
+
+#include "common/common.h"
+#include "mpv_talloc.h"
+#include "scopes.h"
+
+#define GROUP 256
+
+struct gpu_scopes {
+    pl_log log;
+    pl_gpu gpu;
+    pl_dispatch dp;
+    pl_tex src;
+    pl_buf bins;
+    pl_buf out;
+};
+
+struct gpu_scopes *gpu_scopes_create(void *ta_parent, pl_log log, pl_gpu gpu)
+{
+    if (!(gpu->glsl.compute) || !gpu->limits.max_ssbo_size)
+        return NULL;
+    struct gpu_scopes *s = talloc_zero(ta_parent, struct gpu_scopes);
+    s->log = log;
+    s->gpu = gpu;
+    s->dp = pl_dispatch_create(log, gpu);
+    return s;
+}
+
+void gpu_scopes_destroy(struct gpu_scopes **ps)
+{
+    struct gpu_scopes *s = *ps;
+    if (!s)
+        return;
+    pl_tex_destroy(s->gpu, &s->src);
+    pl_buf_destroy(s->gpu, &s->bins);
+    pl_buf_destroy(s->gpu, &s->out);
+    pl_dispatch_destroy(&s->dp);
+    talloc_free(s);
+    *ps = NULL;
+}
+
+// Constants and helpers shared by all passes. Literal values make each
+// configuration its own cached pipeline; configurations rarely change.
+static char *common_header(void *ta, const struct mp_scope_params *sp,
+                           const struct mp_scope_layout *l, int aw, int ah)
+{
+    return talloc_asprintf(ta,
+        "#define AW %d\n#define AH %d\n"
+        "#define PW %d\n#define PH %d\n#define CW %d\n"
+        "#define TF %d\n#define PLOTS %d\n#define COLOR_ONE %d\n"
+        "#define PEAK float(%.9g)\n"
+        "#define KR float(%.9g)\n#define KG float(%.9g)\n#define KB float(%.9g)\n"
+        "#define WAVE_OFF %zuu\n#define PARADE_OFF %zuu\n"
+        "#define VECTOR_OFF %zuu\n#define MAX_OFF %zuu\n"
+        "#define TOTAL %zuu\n"
+        "float scope_nits(float e) {\n"
+        "    if (e <= 0.0) return 0.0;\n"
+        "#if TF == 1\n"
+        "    float p = pow(e, 1.0 / 78.84375);\n"
+        "    return 10000.0 * pow(max(p - 0.8359375, 0.0) / (18.8515625 - 18.6875 * p),\n"
+        "                         1.0 / 0.1593017578125);\n"
+        "#elif TF == 2\n"
+        "    const float a = 0.17883277, b = 1.0 - 4.0 * a, c = 0.5 - a * log(4.0 * a);\n"
+        "    float scene = e <= 0.5 ? e * e / 3.0 : (exp((e - c) / a) + b) / 12.0;\n"
+        "    return PEAK * pow(scene, 1.2);\n"
+        "#else\n"
+        "    return e;\n"
+        "#endif\n"
+        "}\n"
+        "uint scope_level(float v) {\n"
+        "#if TF != 0\n"
+        "    const float log10e = 0.4342944819;\n"
+        "    v = (log(clamp(v, 0.1, PEAK)) * log10e + 1.0) / (log(PEAK) * log10e + 1.0);\n"
+        "#endif\n"
+        "    return uint(clamp(v, 0.0, 1.0) * float(PH - 1));\n"
+        "}\n"
+        // Linear invocation index over a 2D grid of 1D work groups.
+        "uint scope_index() {\n"
+        "    return gl_GlobalInvocationID.y * gl_NumWorkGroups.x * %du +\n"
+        "           gl_GlobalInvocationID.x;\n"
+        "}\n",
+        aw, ah, sp->w, sp->h, l->parade_w, (int)sp->transfer, sp->plots,
+        MP_SCOPE_COLOR_ONE, sp->peak, sp->kr, sp->kg, sp->kb,
+        l->wave, l->parade, l->vector, l->max, l->total, GROUP);
+}
+
+static struct pl_shader_desc buf_desc(void *ta, const char *name,
+                                      const char *var, pl_buf buf, size_t n,
+                                      enum pl_desc_access access)
+{
+    struct pl_buffer_var *bv = talloc_zero(ta, struct pl_buffer_var);
+    bv->var = (struct pl_var) {
+        .name = var,
+        .type = PL_VAR_UINT,
+        .dim_v = 1,
+        .dim_m = 1,
+        .dim_a = n,
+    };
+    bv->layout = pl_std430_layout(0, &bv->var);
+    return (struct pl_shader_desc) {
+        .desc = {
+            .name = name,
+            .type = PL_DESC_BUF_STORAGE,
+            .access = access,
+        },
+        .binding.object = buf,
+        .buffer_vars = bv,
+        .num_buffer_vars = 1,
+        .memory = PL_MEMORY_COHERENT,
+    };
+}
+
+static bool dispatch(struct gpu_scopes *s, const char *description,
+                     const char *header, const char *body,
+                     const struct pl_shader_desc *descs, int num_descs,
+                     int group_w, int group_h, size_t shmem, int gx, int gy)
+{
+    pl_shader sh = pl_dispatch_begin(s->dp);
+    bool ok = pl_shader_custom(sh, &(struct pl_custom_shader) {
+        .description = description,
+        .header = header,
+        .body = body,
+        .input = PL_SHADER_SIG_NONE,
+        .output = PL_SHADER_SIG_NONE,
+        .descriptors = descs,
+        .num_descriptors = num_descs,
+        .compute = true,
+        .compute_group_size = {group_w, group_h},
+        .compute_shmem = shmem,
+    });
+    if (!ok) {
+        pl_dispatch_abort(s->dp, &sh);
+        return false;
+    }
+    return pl_dispatch_compute(s->dp, pl_dispatch_compute_params(
+        .shader = &sh,
+        .dispatch_size = {gx, gy, 1},
+    ));
+}
+
+// Dispatch for n invocations in 1D groups of GROUP threads.
+static bool dispatch_1d(struct gpu_scopes *s, const char *description,
+                        const char *header, const char *body,
+                        const struct pl_shader_desc *descs, int num_descs,
+                        size_t shmem, size_t n)
+{
+    size_t groups = MPMAX((n + GROUP - 1) / GROUP, 1);
+    size_t gx = MPMIN(groups, s->gpu->limits.max_dispatch[0]);
+    size_t gy = (groups + gx - 1) / gx;
+    if (gy > s->gpu->limits.max_dispatch[1])
+        return false;
+    return dispatch(s, description, header, body, descs, num_descs,
+                    GROUP, 1, shmem, gx, gy);
+}
+
+static const char accumulate_body[] =
+    "ivec2 pos = ivec2(gl_GlobalInvocationID.xy);\n"
+    "if (pos.x < AW && pos.y < AH) {\n"
+    "    vec3 e = clamp(texelFetch(scope_src, pos, 0).rgb, 0.0, 1.0);\n"
+    "    vec3 v = vec3(scope_nits(e.r), scope_nits(e.g), scope_nits(e.b));\n"
+    "    uint ly = scope_level(KR * v.r + KG * v.g + KB * v.b);\n"
+    "#if PLOTS & 1\n"
+    "    {\n"
+    "        float norm = TF != 0 ? 1.0 / max(0.001, max(e.r, max(e.g, e.b))) : 1.0;\n"
+    "        uvec3 c = uvec3(clamp(e * norm, 0.0, 1.0) * float(COLOR_ONE) + 0.5);\n"
+    "        uint col = uint(pos.x) * uint(PW) / uint(AW);\n"
+    "        uint i = WAVE_OFF + ((uint(PH) - 1u - ly) * uint(PW) + col) * 4u;\n"
+    "        atomicAdd(scope_bins[i], 1u);\n"
+    "        atomicAdd(scope_bins[i + 1u], c.r);\n"
+    "        atomicAdd(scope_bins[i + 2u], c.g);\n"
+    "        atomicAdd(scope_bins[i + 3u], c.b);\n"
+    "    }\n"
+    "#endif\n"
+    "#if PLOTS & 2\n"
+    "    {\n"
+    "        uint col = PARADE_OFF + (uint(pos.x) * uint(CW) / uint(AW)) * uint(PH);\n"
+    "        atomicAdd(scope_bins[col + scope_level(v.r)], 1u);\n"
+    "        atomicAdd(scope_bins[col + uint(CW * PH) + scope_level(v.g)], 1u);\n"
+    "        atomicAdd(scope_bins[col + uint(2 * CW * PH) + scope_level(v.b)], 1u);\n"
+    "        atomicAdd(scope_bins[col + uint(3 * CW * PH) + ly], 1u);\n"
+    "    }\n"
+    "#endif\n"
+    "#if PLOTS & 4\n"
+    "    {\n"
+    "        float ye = KR * e.r + KG * e.g + KB * e.b;\n"
+    "        float cb = (e.b - ye) / (2.0 * (1.0 - KB));\n"
+    "        float cr = (e.r - ye) / (2.0 * (1.0 - KR));\n"
+    "        int vx = int(float(PH) / 2.0 + cb * float(PH) * 0.9);\n"
+    "        int vy = int(float(PH) / 2.0 - cr * float(PH) * 0.9);\n"
+    "        if (vx >= 0 && vx < PH && vy >= 0 && vy < PH) {\n"
+    "            uvec3 c = uvec3(e * float(COLOR_ONE) + 0.5);\n"
+    "            uint i = VECTOR_OFF + uint(vy * PH + vx) * 4u;\n"
+    "            atomicAdd(scope_bins[i], 1u);\n"
+    "            atomicAdd(scope_bins[i + 1u], c.r);\n"
+    "            atomicAdd(scope_bins[i + 2u], c.g);\n"
+    "            atomicAdd(scope_bins[i + 3u], c.b);\n"
+    "        }\n"
+    "    }\n"
+    "#endif\n"
+    "}\n";
+
+static const char clear_body[] =
+    "uint i = scope_index();\n"
+    "if (i < TOTAL) scope_bins[i] = 0u;\n";
+
+// Per work group maxima in shared memory, then one global atomic per group.
+static const char max_header[] = "shared uint scope_smax[3];\n";
+static const char max_body[] =
+    "uint lid = gl_LocalInvocationIndex;\n"
+    "if (lid < 3u) scope_smax[lid] = 0u;\n"
+    "memoryBarrierShared();\n"
+    "barrier();\n"
+    "uint i = scope_index();\n"
+    "const uint nw = uint(PW * PH), np = uint(4 * CW * PH), nv = uint(PH * PH);\n"
+    "if (i < nw)\n"
+    "    atomicMax(scope_smax[0], scope_bins[WAVE_OFF + i * 4u]);\n"
+    "else if (i < nw + np)\n"
+    "    atomicMax(scope_smax[1], scope_bins[PARADE_OFF + i - nw]);\n"
+    "else if (i < nw + np + nv)\n"
+    "    atomicMax(scope_smax[2], scope_bins[VECTOR_OFF + (i - nw - np) * 4u]);\n"
+    "memoryBarrierShared();\n"
+    "barrier();\n"
+    "if (lid < 3u && scope_smax[lid] > 0u)\n"
+    "    atomicMax(scope_bins[MAX_OFF + lid], scope_smax[lid]);\n";
+
+static const char paint_header[] =
+    "uint scope_pack(vec4 c) {\n"
+    "    uvec4 u = uvec4(c * 255.0);\n"
+    "    return u.b | (u.g << 8) | (u.r << 16) | (u.a << 24);\n"
+    "}\n"
+    "uint scope_paint(uint bin, uint maximum, bool vector) {\n"
+    "    uint count = scope_bins[bin];\n"
+    "    if (count == 0u) return 0u;\n"
+    "    vec3 rgb = vec3(scope_bins[bin + 1u], scope_bins[bin + 2u], scope_bins[bin + 3u]) /\n"
+    "               (float(count) * float(COLOR_ONE));\n"
+    "    float gray = (rgb.r + rgb.g + rgb.b) / 3.0;\n"
+    "    vec3 d = abs(rgb - gray);\n"
+    "    float saturation = min(max(d.r, max(d.g, d.b)) / max(gray, 0.01) * 3.0, 1.0);\n"
+    "    rgb = max(gray + (rgb - gray) * (vector ? 2.0 : 2.5), vec3(vector ? 0.05 : 0.0));\n"
+    "    float mx = max(0.01, max(rgb.r, max(rgb.g, rgb.b)));\n"
+    "    float alpha = min(log2(1.0 + float(count)) / log2(1.0 + float(max(maximum, 1u))) *\n"
+    "                      (vector ? 3.0 : 2.5), 1.0);\n"
+    "    float mixf = vector ? 1.0 : saturation;\n"
+    "    vec3 c = (rgb / mx * mixf + 1.0 - mixf) * alpha;\n"
+    "    return scope_pack(vec4(c, vector ? 1.0 : alpha));\n"
+    "}\n"
+    "uint scope_parade(uint x, uint row) {\n"
+    "    uint c = x / uint(CW + 2), px = x % uint(CW + 2);\n"
+    "    if (c >= 4u || px >= uint(CW)) return 0u;\n"
+    "    uint count = scope_bins[PARADE_OFF + (c * uint(CW) + px) * uint(PH) +\n"
+    "                            uint(PH) - 1u - row];\n"
+    "    if (count == 0u) return 0u;\n"
+    "    const vec3 colors[4] = vec3[4](vec3(1.0, 0.2, 0.2), vec3(0.2, 1.0, 0.2),\n"
+    "                                   vec3(0.3, 0.4, 1.0), vec3(0.85, 0.85, 0.85));\n"
+    "    float v = min(float(count) * 4.0 / float(max(scope_bins[MAX_OFF + 1u], 1u)), 1.0);\n"
+    "    return scope_pack(vec4(colors[c] * v, 1.0));\n"
+    "}\n";
+
+// The output holds the requested plots back to back, one uint per pixel.
+static const char paint_body[] =
+    "uint i = scope_index();\n"
+    "uint o = i;\n"
+    "const uint n = uint(PW * PH), nv = uint(PH * PH);\n"
+    "#if PLOTS & 1\n"
+    "if (i < n) { scope_out[o] = scope_paint(WAVE_OFF + i * 4u, scope_bins[MAX_OFF], false); return; }\n"
+    "i -= n;\n"
+    "#endif\n"
+    "#if PLOTS & 2\n"
+    "if (i < n) { scope_out[o] = scope_parade(i % uint(PW), i / uint(PW)); return; }\n"
+    "i -= n;\n"
+    "#endif\n"
+    "#if PLOTS & 4\n"
+    "if (i < nv) scope_out[o] = scope_paint(VECTOR_OFF + i * 4u, scope_bins[MAX_OFF + 2u], true);\n"
+    "#endif\n";
+
+bool gpu_scopes_run(struct gpu_scopes *s, pl_renderer rr,
+                    const struct pl_frame *image,
+                    const struct pl_color_space *color,
+                    const struct mp_scope_params *sp, int aw, int ah,
+                    uint8_t *plot[3])
+{
+    pl_gpu gpu = s->gpu;
+    if (aw < 1 || ah < 1 || (int64_t)aw * ah > MP_SCOPE_MAX_SAMPLES ||
+        aw > gpu->limits.max_tex_2d_dim || ah > gpu->limits.max_tex_2d_dim)
+        return false;
+
+    struct mp_scope_layout l;
+    mp_scope_layout(sp, &l);
+    size_t out_size[3], out_total = 0;
+    for (int i = 0; i < 3; i++) {
+        out_size[i] = sp->plots & (1 << i) ? mp_scope_plot_size(sp, i) / 4 : 0;
+        out_total += out_size[i];
+    }
+    if (l.total * 4 > gpu->limits.max_ssbo_size ||
+        out_total * 4 > gpu->limits.max_ssbo_size)
+        return false;
+
+    pl_fmt fmt = pl_find_fmt(gpu, PL_FMT_UNORM, 4, 16, 16,
+                             PL_FMT_CAP_RENDERABLE | PL_FMT_CAP_SAMPLEABLE);
+    bool ok = fmt &&
+        pl_tex_recreate(gpu, &s->src, pl_tex_params(
+            .w = aw,
+            .h = ah,
+            .format = fmt,
+            .renderable = true,
+            .sampleable = true,
+        )) &&
+        pl_buf_recreate(gpu, &s->bins, pl_buf_params(
+            .size = l.total * 4,
+            .storable = true,
+        )) &&
+        pl_buf_recreate(gpu, &s->out, pl_buf_params(
+            .size = out_total * 4,
+            .storable = true,
+            .host_readable = true,
+        ));
+    if (!ok)
+        return false;
+
+    // Same color space in and out: libplacebo only decodes, crops, rotates and
+    // averages, keeping the encoded signal values.
+    struct pl_frame target = {
+        .num_planes = 1,
+        .planes[0] = {
+            .texture = s->src,
+            .components = 4,
+            .component_mapping = {0, 1, 2, 3},
+        },
+        .repr = pl_color_repr_rgb,
+        .color = *color,
+    };
+    struct pl_render_params params = pl_render_fast_params;
+    params.downscaler = &pl_filter_box;
+    params.disable_linear_scaling = true;
+    params.skip_caching_single_frame = true;
+    if (!pl_render_image(rr, image, &target, &params))
+        return false;
+
+    void *ta = talloc_new(NULL);
+    char *header = common_header(ta, sp, &l, aw, ah);
+    struct pl_shader_desc bins_rw = buf_desc(ta, "scope_bins_buf", "scope_bins",
+                                             s->bins, l.total,
+                                             PL_DESC_ACCESS_READWRITE);
+    struct pl_shader_desc accumulate[2] = {
+        {
+            .desc = { .name = "scope_src", .type = PL_DESC_SAMPLED_TEX },
+            .binding = {
+                .object = s->src,
+                .sample_mode = PL_TEX_SAMPLE_NEAREST,
+            },
+        },
+        bins_rw,
+    };
+    struct pl_shader_desc paint[2] = {
+        buf_desc(ta, "scope_bins_buf", "scope_bins", s->bins, l.total,
+                 PL_DESC_ACCESS_READONLY),
+        buf_desc(ta, "scope_out_buf", "scope_out", s->out, out_total,
+                 PL_DESC_ACCESS_WRITEONLY),
+    };
+
+    ok = dispatch_1d(s, "scope clear", header, clear_body, &bins_rw, 1, 0, l.total) &&
+         dispatch(s, "scope accumulate", header, accumulate_body, accumulate, 2,
+                  16, 16, 0, (aw + 15) / 16, (ah + 15) / 16) &&
+         dispatch_1d(s, "scope max", talloc_asprintf(ta, "%s%s", header, max_header),
+                     max_body, &bins_rw, 1, sizeof(uint32_t[3]),
+                     (size_t)sp->w * sp->h + 4 * l.parade_w * sp->h +
+                     (size_t)sp->h * sp->h) &&
+         dispatch_1d(s, "scope paint", talloc_asprintf(ta, "%s%s", header, paint_header),
+                     paint_body, paint, 2, 0, out_total);
+
+    size_t offset = 0;
+    for (int i = 0; ok && i < 3; i++) {
+        if (!out_size[i])
+            continue;
+        ok = pl_buf_read(gpu, s->out, offset * 4, plot[i], out_size[i] * 4);
+        offset += out_size[i];
+    }
+    talloc_free(ta);
+    return ok;
+}
