+// SPDX-License-Identifier: GPL-3.0-or-later
+
+#include <math.h>
+#include <stdlib.h>
+#include <string.h>
+
+#include "scope.h"
+
+// Standalone (no talloc/common.h) so the math can be tested in isolation.
+#define SCOPE_MAX(a, b) ((a) > (b) ? (a) : (b))
+
+// Lookup tables are indexed by the top 12 bits of each 16-bit sample.
+#define LUT_BITS 12
+#define LUT_SIZE (1 << LUT_BITS)
+
+bool mp_scope_params_init(struct mp_scope_params *sp, int w, int plots,
+                          const struct pl_color_space *color)
+{
+    if (w < MP_SCOPE_MIN_WIDTH || w > MP_SCOPE_MAX_WIDTH || !(plots & MP_SCOPE_ALL))
+        return false;
+
+    enum mp_scope_transfer transfer;
+    float peak;
+    switch (color->transfer) {
+    case PL_COLOR_TRC_UNKNOWN:
+        return false;
+    case PL_COLOR_TRC_PQ:
+        transfer = MP_SCOPE_PQ;
+        peak = 10000;
+        break;
+    case PL_COLOR_TRC_HLG:
+        // Display-referred HLG with the nominal 1000 nit reference display.
+        transfer = MP_SCOPE_HLG;
+        peak = 1000;
+        break;
+    default:
+        if (pl_color_transfer_is_hdr(color->transfer))
+            return false;
+        transfer = MP_SCOPE_SDR;
+        peak = 100;
+        break;
+    }
+
+    const struct pl_raw_primaries *raw = pl_raw_primaries_get(color->primaries);
+    if (color->primaries == PL_COLOR_PRIM_UNKNOWN || !raw)
+        return false;
+    pl_matrix3x3 rgb2xyz = pl_get_rgb2xyz_matrix(raw);
+
+    *sp = (struct mp_scope_params) {
+        .w = w,
+        .h = lround(w * 9.0 / 16),
+        .plots = plots & MP_SCOPE_ALL,
+        .transfer = transfer,
+        .peak = peak,
+        .kr = rgb2xyz.m[1][0],
+        .kg = rgb2xyz.m[1][1],
+        .kb = rgb2xyz.m[1][2],
+    };
+    return true;
+}
+
+void mp_scope_layout(const struct mp_scope_params *sp, struct mp_scope_layout *l)
+{
+    int w = sp->w, h = sp->h;
+    l->parade_w = (w - 6) / 4;
+    l->wave = 0;
+    l->parade = l->wave + (size_t)w * h * 4;
+    l->vector = l->parade + (size_t)l->parade_w * h * 4;
+    l->max = l->vector + (size_t)h * h * 4;
+    l->total = l->max + 3;
+}
+
+size_t mp_scope_plot_size(const struct mp_scope_params *sp, int plot)
+{
+    return (size_t)(plot == 2 ? sp->h : sp->w) * sp->h * 4;
+}
+
+static float scope_nits(const struct mp_scope_params *sp, float e)
+{
+    if (e <= 0)
+        return 0;
+    switch (sp->transfer) {
+    case MP_SCOPE_PQ: {
+        float p = powf(e, 1.0f / 78.84375f);
+        return 10000 * powf(fmaxf(p - 0.8359375f, 0) / (18.8515625f - 18.6875f * p),
+                            1.0f / 0.1593017578125f);
+    }
+    case MP_SCOPE_HLG: {
+        const float a = 0.17883277f, b = 1 - 4 * a, c = 0.5f - a * logf(4 * a);
+        float scene = e <= 0.5f ? e * e / 3 : (expf((e - c) / a) + b) / 12;
+        return sp->peak * powf(scene, 1.2f);
+    }
+    default:
+        return e;
+    }
+}
+
+static int scope_level(const struct mp_scope_params *sp, float v)
+{
+    float n = v;
+    if (sp->transfer != MP_SCOPE_SDR) {
+        n = (log10f(fmaxf(0.1f, fminf(v, sp->peak))) + 1) /
+            (log10f(sp->peak) + 1);
+    }
+    return fmaxf(0, fminf(n, 1)) * (sp->h - 1);
+}
+
+static uint32_t fixed_color(float c)
+{
+    return fmaxf(0, fminf(c, 1)) * MP_SCOPE_COLOR_ONE + 0.5f;
+}
+
+void mp_scope_accumulate(const struct mp_scope_params *sp, uint32_t *bins,
+                         const uint16_t *rgba, int w, int h, ptrdiff_t stride,
+                         int rotate)
+{
+    struct mp_scope_layout l;
+    mp_scope_layout(sp, &l);
+    const int pw = sp->w, ph = sp->h;
+    const bool wave = sp->plots & MP_SCOPE_WAVEFORM;
+    const bool parade = sp->plots & MP_SCOPE_PARADE;
+    const bool vector = sp->plots & MP_SCOPE_VECTORSCOPE;
+
+    // Values and levels per code value, so that the per-sample work is table
+    // lookups plus one luma level.
+    float value[LUT_SIZE];
+    uint16_t level[LUT_SIZE];
+    for (int i = 0; i < LUT_SIZE; i++) {
+        value[i] = scope_nits(sp, i / (float)(LUT_SIZE - 1));
+        level[i] = scope_level(sp, value[i]);
+    }
+
+    // Plot columns follow display columns. Vertical flips happen after
+    // rotation in display space and never move a sample between columns.
+    bool swap = rotate == 90 || rotate == 270;
+    int dw = swap ? h : w;
+    int *wave_col = malloc(sizeof(int) * dw * 2);
+    if (!wave_col)
+        return;
+    int *parade_col = wave_col + dw;
+    for (int x = 0; x < dw; x++) {
+        wave_col[x] = (int64_t)x * pw / dw;
+        parade_col[x] = (int64_t)x * l.parade_w / dw;
+    }
+
+    uint32_t *wave_bins = bins + l.wave, *parade_bins = bins + l.parade;
+    uint32_t *vector_bins = bins + l.vector;
+    const float scale = 1.0f / 65535;
+    for (int y = 0; y < h; y++) {
+        const uint16_t *row = (const uint16_t *)((const uint8_t *)rgba + y * stride);
+        for (int x = 0; x < w; x++) {
+            const uint16_t *p = &row[x * 4];
+            int dx = rotate == 90 ? h - 1 - y : rotate == 180 ? w - 1 - x :
+                     rotate == 270 ? y : x;
+            int ci[3] = { p[0] >> (16 - LUT_BITS), p[1] >> (16 - LUT_BITS),
+                          p[2] >> (16 - LUT_BITS) };
+            float r = p[0] * scale, g = p[1] * scale, b = p[2] * scale;
+            float luma = sp->kr * value[ci[0]] + sp->kg * value[ci[1]] +
+                         sp->kb * value[ci[2]];
+            int luma_level = scope_level(sp, luma);
+
+            if (wave) {
+                float norm = 1;
+                if (sp->transfer != MP_SCOPE_SDR)
+                    norm = 1 / fmaxf(0.001f, fmaxf(r, fmaxf(g, b)));
+                uint32_t *bin = &wave_bins[((ph - 1 - luma_level) * pw + wave_col[dx]) * 4];
+                bin[0] += 1;
+                bin[1] += fixed_color(r * norm);
+                bin[2] += fixed_color(g * norm);
+                bin[3] += fixed_color(b * norm);
+            }
+
+            if (parade) {
+                uint32_t *col = &parade_bins[parade_col[dx] * ph];
+                for (int c = 0; c < 3; c++)
+                    col[(c * l.parade_w) * ph + level[ci[c]]] += 1;
+                col[(3 * l.parade_w) * ph + luma_level] += 1;
+            }
+
+            if (vector) {
+                // Chroma of the encoded signal, matching the source primaries.
+                float y_e = sp->kr * r + sp->kg * g + sp->kb * b;
+                float cb = (b - y_e) / (2 * (1 - sp->kb));
+                float cr = (r - y_e) / (2 * (1 - sp->kr));
+                int vx = ph / 2.0f + cb * ph * 0.9f;
+                int vy = ph / 2.0f - cr * ph * 0.9f;
+                if (vx >= 0 && vx < ph && vy >= 0 && vy < ph) {
+                    uint32_t *bin = &vector_bins[(vy * ph + vx) * 4];
+                    bin[0] += 1;
+                    bin[1] += fixed_color(r);
+                    bin[2] += fixed_color(g);
+                    bin[3] += fixed_color(b);
+                }
+            }
+        }
+    }
+    free(wave_col);
+}
+
+// Saturation-boosted average color with log-scaled density as alpha.
+static void paint_bins(const uint32_t *bins, int n, uint8_t *out, bool vector)
+{
+    uint32_t maximum = 1;
+    for (int i = 0; i < n; i++)
+        maximum = SCOPE_MAX(maximum, bins[i * 4]);
+    float norm = log2f(1 + (float)maximum);
+    for (int i = 0; i < n; i++) {
+        const uint32_t *bin = &bins[i * 4];
+        if (!bin[0])
+            continue;
+        float k = 1.0f / ((float)bin[0] * MP_SCOPE_COLOR_ONE);
+        float r = bin[1] * k, g = bin[2] * k, b = bin[3] * k;
+        float gray = (r + g + b) / 3, boost = vector ? 2 : 2.5f;
+        float saturation = fminf(fmaxf(fabsf(r - gray), fmaxf(fabsf(g - gray), fabsf(b - gray))) /
+                                 fmaxf(gray, 0.01f) * 3, 1);
+        float floor = vector ? 0.05f : 0;
+        r = fmaxf(gray + (r - gray) * boost, floor);
+        g = fmaxf(gray + (g - gray) * boost, floor);
+        b = fmaxf(gray + (b - gray) * boost, floor);
+        float mx = fmaxf(0.01f, fmaxf(r, fmaxf(g, b)));
+        float alpha = fminf(log2f(1 + (float)bin[0]) / norm * (vector ? 3 : 2.5f), 1);
+        float mix = vector ? 1 : saturation;
+        out[4 * i + 0] = (b / mx * mix + 1 - mix) * alpha * 255;
+        out[4 * i + 1] = (g / mx * mix + 1 - mix) * alpha * 255;
+        out[4 * i + 2] = (r / mx * mix + 1 - mix) * alpha * 255;
+        out[4 * i + 3] = vector ? 255 : alpha * 255;
+    }
+}
+
+void mp_scope_paint(const struct mp_scope_params *sp, uint32_t *bins,
+                    uint8_t *plot[3])
+{
+    struct mp_scope_layout l;
+    mp_scope_layout(sp, &l);
+    int w = sp->w, h = sp->h;
+
+    if (plot[0])
+        paint_bins(bins + l.wave, w * h, plot[0], false);
+    if (plot[2])
+        paint_bins(bins + l.vector, h * h, plot[2], true);
+    if (plot[1]) {
+        const uint32_t *par = bins + l.parade;
+        size_t n = (size_t)l.parade_w * h * 4;
+        uint32_t maximum = 1;
+        for (size_t i = 0; i < n; i++)
+            maximum = SCOPE_MAX(maximum, par[i]);
+        static const float colors[4][3] = {
+            {1, .2, .2}, {.2, 1, .2}, {.3, .4, 1}, {.85, .85, .85},
+        };
+        for (int c = 0; c < 4; c++) {
+            for (int x = 0; x < l.parade_w; x++) {
+                for (int lv = 0; lv < h; lv++) {
+                    uint32_t count = par[(c * l.parade_w + x) * h + lv];
+                    if (!count)
+                        continue;
+                    float v = fminf(count * 4.0f / maximum, 1);
+                    uint8_t *px = &plot[1][((h - 1 - lv) * w + c * (l.parade_w + 2) + x) * 4];
+                    px[0] = colors[c][2] * v * 255;
+                    px[1] = colors[c][1] * v * 255;
+                    px[2] = colors[c][0] * v * 255;
+                    px[3] = 255;
+                }
+            }
+        }
+    }
+}
