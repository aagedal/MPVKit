+// Like mp_image_hw_download(), but maps the surface read-only without a copy
+// where the hwcontext supports it (e.g. VideoToolbox). The mapping is held
+// until the returned image is freed.
+struct mp_image *mp_image_hw_map_or_download(struct mp_image *src)
+{
+    struct mp_image *dst = NULL;
+    AVFrame *srcav = mp_image_to_av_frame(src);
+    AVFrame *dstav = av_frame_alloc();
+    if (srcav && dstav) {
+        dstav->format = AV_PIX_FMT_NONE;
+        if (av_hwframe_map(dstav, srcav, AV_HWFRAME_MAP_READ) >= 0)
+            dst = mp_image_from_av_frame(dstav);
+    }
+    av_frame_free(&srcav);
+    av_frame_free(&dstav);
+    if (!dst)
+        return mp_image_hw_download(src, NULL);
+    mp_image_set_size(dst, src->w, src->h);
+    mp_image_copy_attributes(dst, src);
+    return dst;
+}
