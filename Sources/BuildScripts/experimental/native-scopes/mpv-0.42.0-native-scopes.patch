+
+// Memory a raster would take once in system memory, or -1 if unknown.
+static int raster_size(struct mp_image *mpi)
+{
+    if (!IMGFMT_IS_HWACCEL(mpi->imgfmt))
+        return mp_image_approx_byte_size(mpi);
+    if (!mpi->hwctx)
+        return -1;
+    AVHWFramesContext *ctx = (void *)mpi->hwctx->data;
+    int format = mp_image_hw_download_get_sw_format(mpi);
+    if (!format || ctx->width <= 0 || ctx->height <= 0 ||
+        ctx->width > RASTER_MAX_DIM || ctx->height > RASTER_MAX_DIM)
+        return -1;
+    return mp_image_get_alloc_size(format, ctx->width, ctx->height, 64);
+}
+
+// Exact PTS association is only safe while decoder output is strictly
+// increasing. Ambiguity is remembered until reset, even after a duplicate
+// has fallen out of the ring.
+static void raster_track_pts(struct priv *p, double pts)
+{
+    mp_mutex_lock(&p->cache_lock);
+    if (!isfinite(pts) || (p->raster_have_pts && pts <= p->raster_last_pts))
+        p->raster_pts_ambiguous = true;
+    p->raster_have_pts = true;
+    p->raster_last_pts = pts;
+    if (p->raster_pts_ambiguous) {
+        for (int n = 0; n < MP_ARRAY_SIZE(p->rasters); n++)
+            mp_image_unrefp(&p->rasters[n]);
+    }
+    mp_mutex_unlock(&p->cache_lock);
+}
+
+static void raster_store(struct priv *p, struct mp_image *mpi)
+{
+    int bytes = raster_size(mpi);
+    if (bytes <= 0 || bytes > RASTER_MAX_BYTES)
+        return;
+
+    mp_mutex_lock(&p->cache_lock);
+    if (!p->raster_pts_ambiguous) {
+        const int n = MP_ARRAY_SIZE(p->rasters);
+        mp_image_unrefp(&p->rasters[n - 1]);
+        memmove(&p->rasters[1], &p->rasters[0], (n - 1) * sizeof(p->rasters[0]));
+        memmove(&p->raster_bytes[1], &p->raster_bytes[0], (n - 1) * sizeof(int));
+        p->rasters[0] = mp_image_new_ref(mpi);
+        p->raster_bytes[0] = p->rasters[0] ? bytes : 0;
+        if (p->rasters[0]) {
+            p->rasters[0]->params = p->fixed_format;
+            // Unspecified decoder PAR resolves to the established square pixels.
+            if (mpi->params.p_w == 0)
+                p->rasters[0]->params.p_w = p->rasters[0]->params.p_h = 1;
+        }
+        int total = 0;
+        for (int i = 0; i < n; i++)
+            total += p->raster_bytes[i];
+        for (int i = n - 1; i > 0 && total > RASTER_CACHE_BYTES; i--) {
+            total -= p->raster_bytes[i];
+            p->raster_bytes[i] = 0;
+            mp_image_unrefp(&p->rasters[i]);
+        }
+    }
+    mp_mutex_unlock(&p->cache_lock);
+}
