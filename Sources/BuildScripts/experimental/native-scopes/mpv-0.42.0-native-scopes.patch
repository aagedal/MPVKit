--- /dev/null
+++ b/video/scope.h
@@ -0,0 +1,79 @@
+// Copyright © 2026 Truls Aagedal
+// SPDX-License-Identifier: GPL-3.0-or-later
+//
+// Waveform, RGBY parade and vectorscope analysis of the encoded video signal.
+// The binning and painting rules are shared by the CPU path (scope.c) and the
+// gpu-next compute path (video/out/gpu_next/scopes.c), which must stay in sync.
+
+#pragma once
+
+#include <stdbool.h>
+#include <stddef.h>
+#include <stdint.h>
+
+#include <libplacebo/colorspace.h>
+
+enum {
+    MP_SCOPE_WAVEFORM    = 1 << 0,
+    MP_SCOPE_PARADE      = 1 << 1,
+    MP_SCOPE_VECTORSCOPE = 1 << 2,
+    MP_SCOPE_ALL         = (1 << 3) - 1,
+};
+
+enum mp_scope_transfer {
+    MP_SCOPE_SDR, // levels are encoded code values
+    MP_SCOPE_PQ,  // levels are log10 nits up to `peak`
+    MP_SCOPE_HLG,
+};
+
+#define MP_SCOPE_MIN_WIDTH 64
+#define MP_SCOPE_MAX_WIDTH 1440
+// Fixed-point scale of the per-bin color sums. 8 bits keeps the sums of a
+// 4096x4096 analysis grid within uint32_t.
+#define MP_SCOPE_COLOR_ONE 255
+#define MP_SCOPE_MAX_SAMPLES (4096 * 4096)
+
+struct mp_scope_params {
+    int w, h;       // waveform/parade size; vectorscope is h x h
+    int plots;      // MP_SCOPE_* mask
+    enum mp_scope_transfer transfer;
+    float peak;     // nits at the top of an HDR axis
+    float kr, kg, kb; // luma coefficients of the source primaries
+};
+
+// Bin layout, as uint32_t offsets into one array. Waveform and vectorscope bins
+// hold {count, r, g, b}, parade bins a count per (channel, column, level).
+struct mp_scope_layout {
+    int parade_w;   // width of one parade channel
+    size_t wave, parade, vector, max, total;
+};
+
+// Plot outputs, premultiplied BGRA8. Unrequested plots are NULL.
+struct mp_scope_result {
+    struct mp_scope_params params;
+    double pts;
+    const char *primaries, *transfer;
+    int analysis_w, analysis_h;
+    bool dolby_vision;
+    bool gpu;
+    uint8_t *plot[3]; // waveform (w*h), parade (w*h), vectorscope (h*h)
+};
+
+// Sets up params for a source with the given encoded color space. Fails for
+// signals the scopes cannot represent (unknown or non-PQ/HLG HDR transfers).
+bool mp_scope_params_init(struct mp_scope_params *sp, int w, int plots,
+                          const struct pl_color_space *color);
+
+void mp_scope_layout(const struct mp_scope_params *sp, struct mp_scope_layout *l);
+size_t mp_scope_plot_size(const struct mp_scope_params *sp, int plot);
+
+// Bins an encoded, full-range RGBA64 image that is displayed rotated
+// clockwise by `rotate` degrees (a multiple of 90). `bins` must be zeroed and
+// hold layout.total entries.
+void mp_scope_accumulate(const struct mp_scope_params *sp, uint32_t *bins,
+                         const uint16_t *rgba, int w, int h, ptrdiff_t stride,
+                         int rotate);
+
+// Fills the requested (non-NULL) zeroed plot buffers from accumulated bins.
+void mp_scope_paint(const struct mp_scope_params *sp, uint32_t *bins,
+                    uint8_t *plot[3]);
