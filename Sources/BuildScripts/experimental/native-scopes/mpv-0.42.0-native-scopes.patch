+// Whether decoder output of this size is presented without crop, scaling or
+// timing reinterpretation, so that a cached raster is the presented frame.
+static bool raster_allowed(struct priv *p, int w, int h)
+{
+    const struct dec_wrapper_opts *o = p->opts;
+    const struct mp_image_params *f = &p->fixed_format;
+    return o->aagedal_decoder_raster && !f->aagedal_transform_invalid &&
