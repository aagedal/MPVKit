diff --git a/video/out/vulkan/context_moltenvk.m b/video/out/vulkan/context_moltenvk.m
index 445b907..7b050ce 100644
--- a/video/out/vulkan/context_moltenvk.m
+++ b/video/out/vulkan/context_moltenvk.m
@@ -26,6 +26,7 @@
 struct priv {
     struct mpvk_ctx vk;
     CAMetalLayer *layer;
+    int width, height;
 };
 
 static void moltenvk_uninit(struct ra_ctx *ctx)
@@ -73,16 +74,41 @@ fail:
     return false;
 }
 
+// The embedding application owns the layer and updates its drawableSize when
+// the host view changes size. Resize the swapchain to match, so vo->dwidth and
+// vo->dheight (and therefore the video and OSD rectangles) follow the layer.
+static void moltenvk_resize(struct ra_ctx *ctx, int w, int h)
+{
+    struct priv *p = ctx->priv;
+    p->width = w;
+    p->height = h;
+    ra_vk_ctx_resize(ctx, w, h);
+}
+
 static bool moltenvk_reconfig(struct ra_ctx *ctx)
 {
     struct priv *p = ctx->priv;
     CGSize s = p->layer.drawableSize;
-    ra_vk_ctx_resize(ctx, s.width, s.height);
+    moltenvk_resize(ctx, s.width, s.height);
     return true;
 }
 
 static int moltenvk_control(struct ra_ctx *ctx, int *events, int request, void *arg)
 {
+    struct priv *p = ctx->priv;
+    if (request == VOCTRL_CHECK_EVENTS) {
+        // Pick up drawableSize changes made while the VO thread is running.
+        // A paused player only gets here when something wakes the VO; the
+        // application can set --moltenvk-surface-size to resize and redraw
+        // immediately.
+        CGSize s = p->layer.drawableSize;
+        int w = s.width, h = s.height;
+        if (w > 1 && h > 1 && (w != p->width || h != p->height)) {
+            moltenvk_resize(ctx, w, h);
+            *events |= VO_EVENT_RESIZE;
+        }
+        return VO_TRUE;
+    }
     return VO_NOTIMPL;
 }
 
