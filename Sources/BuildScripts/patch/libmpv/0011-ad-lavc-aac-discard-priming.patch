Subject: [PATCH] ad_lavc: keep the priming skip of a discarded first frame

FFmpeg returns the AAC priming frame with AV_FRAME_FLAG_DISCARD and its
explicit AV_FRAME_DATA_SKIP_SAMPLES budget. mpv dropped the frame before
reading that side data, so the codec-delay fallback skipped another 1024
samples from the first valid frame and playback started 21.333 ms late at
48 kHz. Remember a positive initial skip before discarding, mark preroll
handled, and consume pending skip against every discarded frame's samples.

Aagedal Media Converter: docs/dependency-patches/mpv-0.41.0-aac-discard-priming.patch

diff --git a/audio/decode/ad_lavc.c b/audio/decode/ad_lavc.c
index 9c83892..41db4e0 100644
--- a/audio/decode/ad_lavc.c
+++ b/audio/decode/ad_lavc.c
@@ -208,8 +208,25 @@ static int receive_frame(struct mp_filter *da, struct mp_frame *out)
         MP_ERR(da, "Error decoding audio.\n");
     }
 
-    if (priv->avframe->flags & AV_FRAME_FLAG_DISCARD)
+    if (priv->avframe->flags & AV_FRAME_FLAG_DISCARD) {
+        // A discarded initial priming frame can already consume the codec delay.
+        // Remember its explicit skip budget before dropping its side data, or the
+        // delay fallback below would skip the first valid decoded frame again.
+        AVFrameSideData *sd = av_frame_get_side_data(priv->avframe,
+                                                   AV_FRAME_DATA_SKIP_SAMPLES);
+        if (!priv->preroll_done && sd && sd->size >= 10) {
+            uint32_t skip = AV_RL32(sd->data);
+            if (skip) {
+                priv->skip_samples = skip;
+                priv->preroll_done = true;
+            }
+        }
+        // Discarded samples also consume an outstanding multi-frame skip budget.
+        uint32_t consumed = MPMIN(priv->skip_samples,
+                                  (uint32_t)priv->avframe->nb_samples);
+        priv->skip_samples -= consumed;
         av_frame_unref(priv->avframe);
+    }
 
     if (!priv->avframe->buf[0])
         return ret;
